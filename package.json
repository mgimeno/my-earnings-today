{
  "name": "my-earnings-today",
  "sideEffects": [
    "src/polyfills.ts"
  ],
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration production",
    "build:prod": "ng build --configuration production && npm run pre-brotli:dist",
    "generate:material-symbols-font": "tsx scripts/generate-material-symbols-font.ts",
    "pre-gzip:dist": "node scripts/pre-gzip-dist.mjs",
    "pre-brotli:dist": "node scripts/pre-brotli-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.spec.json",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check-all-updatable-dependencies": "npx npm-check-updates -u",
    "update-all-dependencies": "npx npm-check-updates -u && npm i -f"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions",
    "Firefox ESR"
  ],
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/localize": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@fontsource/montserrat": "^5.3.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/language-service": "^22.1.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@angular/build": {
      "vitest": "$vitest"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
